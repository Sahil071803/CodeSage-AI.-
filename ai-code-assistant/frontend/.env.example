# Base URL of the Java/Spring Boot backend (no trailing slash).
# Only non-secret values belong here: anything prefixed VITE_ is bundled into the browser.
VITE_API_BASE_URL=http://localhost:9090

# true  = Demo Mode (built-in mock data, no backend needed)
# false = call the real backend (set the paths in src/services/api.js first)
VITE_USE_MOCK=true
